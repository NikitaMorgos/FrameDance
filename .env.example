# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Имя бота для входа на сайт (без @), например FrameDance_bot
BOT_USERNAME=FrameDance_bot

# База данных (путь к SQLite)
DATABASE_PATH=./data/framedance.db

# Сайт (порт и URL для ссылок из бота /login)
PORT=3000
# Локально:
SITE_URL=http://localhost:3000
# На домене framedance.ru (на Render в Environment задай SITE_URL=https://framedance.ru):
# SITE_URL=https://framedance.ru